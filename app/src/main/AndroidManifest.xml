<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ML Kit 번역 엔진의 언어 모델 다운로드용 (라이브러리가 병합하는 권한을 명시적으로 드러낸다).
         번역 자체는 세 엔진 모두 기기 안에서 수행하며 입력 문장을 전송하지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 키보드에서는 데이터 요금이 나가는 네트워크로 모델을 받지 않는다 (isActiveNetworkMetered 확인용). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Gemini Nano(AICore) 라이브러리는 minSdk 26 — 코드에서 API 26 미만이면 로드하지 않는다. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt, com.google.mlkit.genai.common" />


    <!-- IME는 입력 이력을 다루므로 백업·기기 이전 반출 경로를 모두 차단한다 -->
    <application
        android:name=".YeonfeelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 폴드·태블릿 설정 2단 구성 활성화 -->
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".settings.LanguageSettingsActivity"
            android:exported="false"
            android:label="@string/settings_language_section" />

        <activity
            android:name=".settings.LayoutSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".settings.ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/settings_section_theme" />

        <activity
            android:name=".settings.MarginSettingsActivity"
            android:exported="false"
            android:label="@string/settings_section_margins" />

        <activity
            android:name=".settings.AccessibilitySettingsActivity"
            android:exported="false"
            android:label="@string/settings_accessibility" />

        <activity
            android:name=".settings.HighContrastSettingsActivity"
            android:exported="false"
            android:label="@string/settings_high_contrast" />

        <activity
            android:name=".settings.SymbolSettingsActivity"
            android:exported="false"
            android:label="@string/symbol_menu" />

        <activity
            android:name=".settings.SymbolPickerActivity"
            android:exported="false" />

        <activity
            android:name=".settings.GestureFeedbackActivity"
            android:exported="false"
            android:label="@string/gesture_feedback_menu" />

        <activity
            android:name=".settings.FeedbackSettingsActivity"
            android:exported="false"
            android:label="@string/touch_feedback_menu" />

        <activity
            android:name=".settings.BackspaceSpeedActivity"
            android:exported="false"
            android:label="@string/gesture_backspace_speed" />

        <activity
            android:name=".settings.ExtraInputSettingsActivity"
            android:exported="false"
            android:label="@string/extra_input_menu" />

        <activity
            android:name=".settings.ResetSettingsActivity"
            android:exported="false"
            android:label="@string/reset_menu" />

        <activity
            android:name=".settings.LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_menu" />

        <activity
            android:name=".settings.DebugSettingsActivity"
            android:exported="false"
            android:label="@string/debug_menu" />

        <activity
            android:name=".settings.TouchCorrectionActivity"
            android:exported="false"
            android:label="@string/debug_touch_correction" />

        <activity
            android:name=".settings.TouchVisualizerActivity"
            android:exported="false"
            android:label="@string/debug_touch_visualizer" />

        <service
            android:name=".ime.YeonfeelImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ML Kit 번역 애드온(#25)의 번역 서비스 바인드 권한. 애드온 매니페스트에도 같은 이름으로 선언한다 —
         어느 앱을 먼저 설치해도 같은 키로 서명한 앱만 이 권한을 받는다. -->
    <permission
        android:name="dev.badalab.yeonfeel.permission.TRANSLATE"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.badalab.yeonfeel.permission.TRANSLATE" />

    <!-- Android 11+ 패키지 가시성: 애드온 서비스에 명시적으로 바인드하고, 설정 화면이 설치 여부를 확인하는 데 필요하다. -->
    <queries>
        <package android:name="dev.badalab.yeonfeel.translate.mlkit" />
    </queries>
    <!-- 키보드는 네트워크를 쓰지 않는다. Gemini Nano 라이브러리가 끌고 오는 Google 사용 통계
         전송 라이브러리(datatransport cct)가 병합하는 네트워크 권한을 걷어낸다 — 추론은 AICore
         시스템 앱이 하므로 필요 없고, 통계는 보내지지 못한 채 버려진다. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Gemini Nano(AICore) 라이브러리는 minSdk 26 — 코드에서 API 26 미만이면 로드하지 않는다. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt, com.google.mlkit.genai.common" />



    <!-- IME는 입력 이력을 다루므로 백업·기기 이전 반출 경로를 모두 차단한다 -->
    <application
        android:name=".YeonfeelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 폴드·태블릿 설정 2단 구성 활성화 -->
        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".settings.LanguageSettingsActivity"
            android:exported="false"
            android:label="@string/settings_language_section" />

        <activity
            android:name=".settings.LayoutSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".settings.ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/settings_section_theme" />

        <activity
            android:name=".settings.MarginSettingsActivity"
            android:exported="false"
            android:label="@string/settings_section_margins" />

        <activity
            android:name=".settings.AccessibilitySettingsActivity"
            android:exported="false"
            android:label="@string/settings_accessibility" />

        <activity
            android:name=".settings.HighContrastSettingsActivity"
            android:exported="false"
            android:label="@string/settings_high_contrast" />

        <activity
            android:name=".settings.SymbolSettingsActivity"
            android:exported="false"
            android:label="@string/symbol_menu" />

        <activity
            android:name=".settings.SymbolPickerActivity"
            android:exported="false" />

        <activity
            android:name=".settings.GestureFeedbackActivity"
            android:exported="false"
            android:label="@string/gesture_feedback_menu" />

        <activity
            android:name=".settings.FeedbackSettingsActivity"
            android:exported="false"
            android:label="@string/touch_feedback_menu" />

        <activity
            android:name=".settings.BackspaceSpeedActivity"
            android:exported="false"
            android:label="@string/gesture_backspace_speed" />

        <activity
            android:name=".settings.ExtraInputSettingsActivity"
            android:exported="false"
            android:label="@string/extra_input_menu" />

        <activity
            android:name=".settings.TranslationSettingsActivity"
            android:exported="false"
            android:label="@string/translate_menu" />

        <activity
            android:name=".settings.ResetSettingsActivity"
            android:exported="false"
            android:label="@string/reset_menu" />

        <activity
            android:name=".settings.LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_menu" />

        <activity
            android:name=".settings.DebugSettingsActivity"
            android:exported="false"
            android:label="@string/debug_menu" />

        <activity
            android:name=".settings.TouchCorrectionActivity"
            android:exported="false"
            android:label="@string/debug_touch_correction" />

        <activity
            android:name=".settings.TouchVisualizerActivity"
            android:exported="false"
            android:label="@string/debug_touch_visualizer" />

        <!-- ML Kit 공통 모듈(Gemini Nano 라이브러리가 의존)은 앱 시작 때 스스로 초기화한다.
             Gemini Nano를 고른 경우에만 필요하므로 빼고, 그 엔진을 처음 만들 때 초기화한다. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <service
            android:name=".ime.YeonfeelImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
